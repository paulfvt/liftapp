<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus. Les photos de progression ne partent jamais dans la sauvegarde cloud,
     mais elles suivent lors d'un transfert direct vers un nouveau téléphone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="photos/" />
    </cloud-backup>
</data-extraction-rules>

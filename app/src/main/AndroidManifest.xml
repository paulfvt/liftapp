<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notification de séance (Android 13+), demandée à la première séance, jamais au lancement. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live Updates d'Android 16 : permission sans demande à l'utilisateur. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Alarme exacte de fin de repos : l'utilisateur l'accorde dans « Alarmes et rappels ». -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Photos de progression prises dans l'app, demandée à la première photo. La caméra n'est pas exigée :
         l'app reste installable sur un appareil sans caméra (l'import depuis la galerie suffit alors). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".LiftApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiftApp">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Récepteurs internes à l'app (exported = false) : seuls l'alarme et la notification de l'app les appellent. -->
        <receiver
            android:name=".workout.notification.RestEndReceiver"
            android:exported="false" />
        <receiver
            android:name=".workout.notification.WorkoutActionReceiver"
            android:exported="false" />

        <!-- Widget d'écran d'accueil : exporté, car c'est Android (le lanceur) qui lui envoie ses mises à jour. -->
        <receiver
            android:name=".widget.LiftWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lift_widget_info" />
        </receiver>

        <!-- Partage de l'image du récap mensuel : l'app choisie dans le menu de partage reçoit un accès temporaire
             à ce seul fichier, sans permission de stockage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

# Modèle de keystore.properties : copier ce fichier en keystore.properties (ignoré par Git) et le remplir.
# Garder la clé hors du dépôt et en sauvegarder une copie avec ses mots de passe : sans elle, impossible de publier
# une mise à jour qui s'installe par-dessus la version précédente.
storeFile=C:/Users/paulf/keys/liftapp-release.jks
storePassword=
keyAlias=release
keyPassword=
